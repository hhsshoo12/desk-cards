<Window x:Class="DeskCards.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Desk Cards 설정" Width="1040" Height="700" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SettingsBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" UseLayoutRounding="True">
    <!-- 제목 표시줄까지 내용으로 쓰고(Mica), 최소화·최대화·닫기 버튼은 시스템이 그린다. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Windows 11 설정의 켬/끔 스위치. 동그라미는 코드에서 옆으로 미끄러뜨린다(Switch). -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel x:Name="Box" Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Text" Text="끔" FontSize="14" Margin="0,0,12,1" MinWidth="16"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
                            <Grid Width="40" Height="20">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource SubFg}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource SubFg}" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                                <Setter TargetName="Knob" Property="Margin" Value="3,0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Text" Property="Text" Value="켬" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentFg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            버튼: 마우스를 올리면 83ms 동안 색이 스르륵 바뀐다(Fluent 컨트롤 상태 전환).
            색은 테마 리소스라 직접 애니메이션할 수 없어서, 위에 겹친 판(Hover)의 투명도를 바꾼다.
            흐리게(사용 안 함)는 맨 바깥(Box), 마우스 효과는 안쪽 판에 걸어 서로 덮어쓰지 않게 한다.
        -->
        <Style x:Key="StdButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Box" MinWidth="96" Height="32">
                            <Border CornerRadius="4" BorderThickness="1" Background="{DynamicResource ControlBg}"
                                    BorderBrush="{DynamicResource ControlBorder}" />
                            <Border x:Name="Hover" CornerRadius="4" Margin="1" Opacity="0" Background="{DynamicResource HoverBg}" />
                            <ContentPresenter x:Name="Content" Margin="12,0,12,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Content" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource StdButton}">
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Box" MinWidth="96" Height="32">
                            <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource Accent}" />
                            <ContentPresenter x:Name="Content" Margin="12,0,12,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Box" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="4" Opacity="0" Background="{DynamicResource HoverBg}" />
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 제목 표시줄의 뒤로 · 메뉴 버튼(Windows 설정과 같은 40×36) -->
        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!--
            Windows 11 설정의 스크롤바: 평소엔 트랙 없이 가는 캡슐(2px)만 보이고,
            마우스를 올리거나 잡으면 굵어지고(6px) 트랙 바탕과 ▲▼ 화살표가 나타난다. 떠나면 0.5초 뒤 다시 가늘어진다.
            내용 위에 겹쳐 떠서 자리를 차지하지 않는다.
        -->
        <Style x:Key="ScrollArrow" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ScrollThumb}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>
                            <Border x:Name="Track" Grid.RowSpan="3" CornerRadius="6" Opacity="0"
                                    Background="{DynamicResource ScrollTrack}" />
                            <RepeatButton x:Name="Up" Style="{StaticResource ScrollArrow}" Opacity="0"
                                          Command="ScrollBar.LineUpCommand" Content="&#xEDDB;" />
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="2" HorizontalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{DynamicResource ScrollThumb}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton x:Name="Down" Grid.Row="2" Style="{StaticResource ScrollArrow}" Opacity="0"
                                          Command="ScrollBar.LineDownCommand" Content="&#xEDDC;" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" BeginTime="0:0:0"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="6" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="1" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Up" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="1" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Down" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="1" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" BeginTime="0:0:0.5"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="2" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="0" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Up" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="0" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Down" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5"><SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="0" KeySpline="0,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentScroll" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource FluentScrollBar}"
                                       HorizontalAlignment="Right" Margin="0,2,3,2" Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                오른쪽 내용. 페이지를 바꾸면 이 판 전체가 움직인다: 하위·상위로 갈 때는 옛 페이지(찍어 둔 그림)가
                한쪽으로 밀려나가고 새 페이지가 반대쪽에서 밀고 들어온다. 메뉴를 바꾸면 새 페이지가 아래에서 올라온다.
                밀려나가는 페이지가 왼쪽 메뉴 위로 넘어가지 않도록 이 칸 안에서 자른다.
            -->
            <Grid x:Name="PageHost" Grid.Column="1" ClipToBounds="True">
                <!-- 나가는 옛 페이지(그림). 새 페이지 아래에 깔려서, 새 페이지가 나타나는 동안 뒤에서 흐려진다. -->
                <Image x:Name="OldPage" IsHitTestVisible="False" Visibility="Collapsed" Stretch="None"
                       HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="OldShift" />
                    </Image.RenderTransform>
                </Image>
                <ScrollViewer x:Name="PageScroller" Style="{StaticResource FluentScroll}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </ScrollViewer.RenderTransform>
                    <StackPanel x:Name="PageContent" Margin="28,0,40,40" MaxWidth="1000">
                        <!-- 페이지 제목(경로)과, 오른쪽 끝의 페이지 전체 켬/끔(예: 카드 바 사용) -->
                        <Grid Margin="0,4,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel x:Name="Breadcrumb" />
                            <ContentControl x:Name="PageAction" Grid.Column="1" Focusable="False"
                                            VerticalAlignment="Center" Margin="16,4,0,0" />
                        </Grid>
                        <StackPanel x:Name="Page" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 좁은 창에서 메뉴를 펼쳤을 때 바깥을 누르면 닫는 판 -->
        <Border x:Name="Scrim" Grid.Row="1" Background="Transparent" Visibility="Collapsed"
                MouseLeftButtonDown="OnScrimDown" />

        <!--
            왼쪽 메뉴. 넓은 창에서는 제목 표시줄 아래 왼쪽 칸에 있고,
            좁은 창에서는 설정 앱처럼 제목 표시줄까지 덮는 판이 된다(위쪽 48은 판 색만 칠하고 버튼은 그 위에 보인다).
        -->
        <Border x:Name="NavPane" Grid.Row="1" Width="300" HorizontalAlignment="Left" Padding="16,4,12,16">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NavShift" />
            </Border.RenderTransform>
            <Grid VerticalAlignment="Top">
                <StackPanel x:Name="Nav" />
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5"
                            Background="{DynamicResource Accent}" />
                </Canvas>
            </Grid>
        </Border>

        <!-- 제목 표시줄: [←] [☰(좁을 때)] 아이콘 Desk Cards. 펼친 메뉴 판보다 위에 그린다. -->
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
            <Button x:Name="BackButton" Style="{StaticResource TitleButton}" ToolTip="뒤로" Click="OnBackClick">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource Fg}" />
            </Button>
            <Button x:Name="PaneButton" Style="{StaticResource TitleButton}" ToolTip="메뉴 열기" Click="OnPaneClick"
                    Visibility="Collapsed">
                <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource Fg}" />
            </Button>
            <Image x:Name="AppIcon" Width="16" Height="16" Margin="8,0,0,0" />
            <TextBlock Text="Desk Cards" FontSize="12" Margin="16,0,0,1" VerticalAlignment="Center"
                       Foreground="{DynamicResource Fg}" />
        </StackPanel>
    </Grid>
</Window>
