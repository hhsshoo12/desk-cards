<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WebView2 합성 컨트롤(투명한 카드 창 안의 .dard 화면)이 Windows SDK 형식을 쓴다. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Desk Cards</Product>
    <Company>hhsshoo12</Company>
    <AssemblyName>DeskCards</AssemblyName>
    <RootNamespace>DeskCards</RootNamespace>
    <Version>0.3.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/StartupState.cs" Link="StartupState.cs" />
    <InternalsVisibleTo Include="DeskCards.RegressionTests" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <!-- 설정 창의 앱 아이콘 -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
