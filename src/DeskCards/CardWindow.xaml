<Window x:Class="DeskCards.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="152" Height="176" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True" Title="Desk Cards Card">
    <Window.Resources>
        <!-- 편집 모드의 크기 조절 손잡이. 완전 투명이면 레이어드 창에서 클릭이 통과하므로 알파 1을 준다. -->
        <Style x:Key="CornerGrip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#01000000">
                            <Path Data="M 15,5 L 5,15 M 15,10 L 10,15" Stroke="{DynamicResource Accent}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 여백·크기·배율은 CardWindow.LayoutFor가 정한다. 안에 CardView가 들어간다. -->
        <Grid x:Name="Layout" Margin="4,4,4,0" />

        <!-- 편집 모드 크기 조절: 비율을 유지한 채 통째로 키우고 줄이므로 모서리 하나만 둔다. -->
        <Thumb x:Name="GripCorner" Style="{StaticResource CornerGrip}" Width="22" Height="22"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Visibility="Collapsed" />
    </Grid>
</Window>
