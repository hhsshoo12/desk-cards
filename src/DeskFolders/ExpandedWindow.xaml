<Window x:Class="DeskFolders.ExpandedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True" Title="DeskFolders">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource PopupBg}">
        <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="TitleBox" FontSize="22" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     MinWidth="120" MaxWidth="420" Margin="0,12,0,0" Padding="6,2" MaxLength="80" />

            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="32,0,32,28" VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False">
                <WrapPanel x:Name="ItemsPanel" VerticalAlignment="Top" />
            </ScrollViewer>

            <!-- 페이지 표시 점 (시작 메뉴처럼 오른쪽 가운데) -->
            <StackPanel x:Name="Dots" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,28" />

            <TextBlock x:Name="Empty" Grid.Row="1" Text="바로가기나 파일을 여기로 끌어다 놓으세요"
                       Foreground="{DynamicResource SubFg}" FontSize="13" Margin="0,0,0,28"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
