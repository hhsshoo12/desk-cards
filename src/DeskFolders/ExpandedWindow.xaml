<Window x:Class="DeskFolders.ExpandedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True" Title="DeskFolders">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource PopupBg}">
        <Grid x:Name="Body" Margin="22,16,22,18" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="TitleBox" FontSize="20" FontWeight="SemiBold" Background="Transparent"
                     BorderThickness="0" Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                     VerticalAlignment="Center" Padding="4,2" MaxLength="80" />

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <WrapPanel x:Name="ItemsPanel" />
            </ScrollViewer>

            <TextBlock x:Name="Empty" Grid.Row="1" Text="바로가기나 파일을 여기로 끌어다 놓으세요"
                       Foreground="{DynamicResource SubFg}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
