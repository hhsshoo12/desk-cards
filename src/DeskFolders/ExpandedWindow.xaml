<Window x:Class="DeskFolders.ExpandedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True" Title="DeskFolders">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="34" Height="34" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource PopupBg}">
        <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="TitleBox" FontSize="22" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Fg}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     MinWidth="120" MaxWidth="300" Margin="0,12,0,0" Padding="6,2" MaxLength="80" />

            <!-- 설정 (시작 메뉴 폴더처럼 오른쪽 위) -->
            <Button x:Name="GearButton" Style="{StaticResource IconButton}" ToolTip="설정"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
                <TextBlock x:Name="GearGlyph" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="26,0,26,28" VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False">
                <WrapPanel x:Name="ItemsPanel" VerticalAlignment="Top" />
            </ScrollViewer>

            <!-- 페이지 표시 점 (시작 메뉴처럼 오른쪽 가운데) -->
            <StackPanel x:Name="Dots" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,7,28" />

            <!-- 설정: 섹션별 묶음. 길어지면 창은 그대로 두고 안에서 스크롤한다. -->
            <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" Margin="0,0,0,20" VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Visibility="Collapsed">
                <StackPanel x:Name="SettingsPanel" Margin="20,0,20,4" />
            </ScrollViewer>

            <TextBlock x:Name="Empty" Grid.Row="1" Text="바로가기나 파일을 여기로 끌어다 놓으세요"
                       Foreground="{DynamicResource SubFg}" FontSize="13" Margin="0,0,0,28"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
