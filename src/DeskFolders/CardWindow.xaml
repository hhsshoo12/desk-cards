<Window x:Class="DeskFolders.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="152" Height="176" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True" Title="DeskFolders Card">
    <Window.Resources>
        <!-- 편집 모드의 크기 조절 손잡이. 완전 투명이면 레이어드 창에서 클릭이 통과하므로 알파 1을 준다. -->
        <Style x:Key="EdgeGrip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#01000000" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CornerGrip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#01000000">
                            <Path Data="M 15,5 L 5,15 M 15,10 L 10,15" Stroke="{DynamicResource Accent}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 여백·크기·배율은 CardWindow.LayoutFor가 정한다. -->
        <Grid x:Name="Layout" Margin="4,4,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.22" />
                </Border.Effect>
            </Border>

            <UniformGrid x:Name="Cells" Rows="2" Columns="2" Margin="12" />

            <TextBlock x:Name="Placeholder" Text="여기로 끌어다 놓기" FontSize="12"
                       Foreground="{DynamicResource SubFg}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False" />

            <TextBlock x:Name="Label" Grid.Row="1" Margin="4,5,4,0" FontSize="13" Foreground="White"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.9" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 편집 끝내기 -->
            <Border x:Name="DoneButton" Visibility="Collapsed" Width="26" Height="26" CornerRadius="13"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                    Background="{DynamicResource Accent}" Cursor="Hand" ToolTip="편집 끝내기">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- 편집 모드 크기 조절(오른쪽, 아래, 모서리) -->
        <Thumb x:Name="GripRight" Style="{StaticResource EdgeGrip}" Width="8" HorizontalAlignment="Right"
               Margin="0,0,0,18" Cursor="SizeWE" Visibility="Collapsed" />
        <Thumb x:Name="GripBottom" Style="{StaticResource EdgeGrip}" Height="8" VerticalAlignment="Bottom"
               Margin="0,0,18,0" Cursor="SizeNS" Visibility="Collapsed" />
        <Thumb x:Name="GripCorner" Style="{StaticResource CornerGrip}" Width="20" Height="20"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Visibility="Collapsed" />
    </Grid>
</Window>
