<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AssemblyName>DeskCards.Setup.Tests</AssemblyName>
    <ApplicationManifest>../../src/DeskCards/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/TestSession.cs" Link="TestSession.cs" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <None Update="fixtures/releases.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../installer/DeskCards.Setup/DeskCards.Setup.csproj" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>
