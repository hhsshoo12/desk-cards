<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../src/DeskCards/app.ico</ApplicationIcon>
    <AssemblyName>DeskCards-Setup</AssemblyName>
    <RootNamespace>DeskCards.Setup</RootNamespace>
    <Version>0.2.1</Version>
    <Product>Desk Cards 설치기</Product>
    <Company>hhsshoo12</Company>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Shared/StartupState.cs" Link="StartupState.cs" />
    <Compile Include="../../src/Shared/InstalledVersionFile.cs" Link="InstalledVersionFile.cs" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <Resource Include="../../src/DeskCards/app.ico" Link="app.ico" />
    <InternalsVisibleTo Include="DeskCards.Setup.Tests" />
  </ItemGroup>
</Project>
